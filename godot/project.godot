; Engine configuration file.
; Minimal project configuration for LinhSinhVN Presentation Shell (DEMO-01-C)

config_version=5

[application]

config/name="LinhSinhVN Presentation Shell"
config/description="Presentation shell for LinhSinhVN headless simulation core"
run/main_scene="res://scenes/world_view.tscn"
