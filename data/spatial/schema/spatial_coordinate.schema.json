{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpatialCoordinate",
  "description": "Deterministic 3D signed integer coordinate representation for LinhSinhVN",
  "type": "object",
  "required": [
    "x",
    "y",
    "z"
  ],
  "additionalProperties": false,
  "properties": {
    "x": {
      "type": "integer",
      "description": "Horizontal X coordinate"
    },
    "y": {
      "type": "integer",
      "description": "Horizontal Y coordinate"
    },
    "z": {
      "type": "integer",
      "description": "Discrete Vertical Z layer coordinate"
    }
  }
}
