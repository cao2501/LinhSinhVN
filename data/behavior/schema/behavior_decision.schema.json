{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://linhsinh.vn/schemas/behavior/behavior_decision.schema.json",
  "title": "BehaviorDecision",
  "description": "Pure evaluated behavioral decision for an individual organism in tick N",
  "type": "object",
  "required": [
    "schema_version",
    "organism_id",
    "simulation_tick",
    "behavior_type",
    "urgency_class",
    "priority_score",
    "target_domain",
    "reason_codes",
    "decision_seed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "organism_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "simulation_tick": {
      "type": "integer",
      "minimum": 0
    },
    "behavior_type": {
      "type": "string",
      "enum": ["FORAGE", "REST", "SEEK_SHELTER", "SEEK_MATE", "FLEE", "EXPLORE"]
    },
    "urgency_class": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "NORMAL", "LOW"]
    },
    "priority_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "target_domain": {
      "type": "string",
      "enum": ["RESOURCE", "SHELTER", "MATE", "SAFETY", "REST", "NONE"]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_seed": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{16}$"
    }
  },
  "additionalProperties": false
}