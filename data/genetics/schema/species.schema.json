{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpeciesDefinition",
  "description": "Biological baseline profile and loci registry for a taxon in LinhSinhVN",
  "type": "object",
  "required": [
    "schema_version",
    "species_id",
    "scientific_name",
    "common_name_vi",
    "status",
    "biodiversity_status",
    "vietnam_territory_recorded",
    "taxonomy",
    "supported_loci"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "species_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "scientific_name": { "type": "string" },
    "common_name_vi": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["PROVISIONAL — BIOLOGICAL VERIFICATION REQUIRED", "VERIFIED"]
    },
    "biodiversity_status": {
      "type": "string",
      "enum": [
        "NATIVE",
        "ENDEMIC",
        "PROVISIONAL",
        "NON_NATIVE_MIGRATORY",
        "NON_NATIVE_INTRODUCED"
      ],
      "description": "Territorial classification within modern Vietnam. Broad regional terms ('Indochina', 'Southeast Asia') are not valid inclusion criteria."
    },
    "vietnam_territory_recorded": {
      "type": "boolean",
      "description": "Whether verifiable records exist within the modern territory of Vietnam"
    },
    "vietnam_evidence_reference": {
      "type": "string",
      "description": "Citation or registry ID of verified Vietnamese biodiversity record, if available"
    },
    "taxonomy": {
      "type": "object",
      "required": ["order", "family"],
      "properties": {
        "order": { "type": "string" },
        "family": { "type": "string" },
        "subfamily": { "type": "string" }
      }
    },
    "supported_loci": {
      "type": "array",
      "items": { "type": "string", "pattern": "^LOCUS_[A-Z0-9_]+$" },
      "uniqueItems": true
    },
    "default_mutation_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "max_mutation_delta": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "additionalProperties": false
}
