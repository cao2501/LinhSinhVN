{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrganismPhenotype",
  "description": "Morphological and physiological traits derived deterministically from gene expression (Gameplay Model)",
  "type": "object",
  "required": [
    "schema_version",
    "sex",
    "body_scale_index",
    "mass_index",
    "cuticle_hardness_index",
    "cephalic_horn_scale",
    "thoracic_horn_scale",
    "tarsal_grip_index",
    "metabolic_drain_index",
    "stamina_economy_modifier",
    "sensory_range_units",
    "cuticle_pigment_ratio"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "sex": { "type": "string", "enum": ["MALE", "FEMALE"] },
    "body_scale_index": { "type": "number", "minimum": 0.0 },
    "mass_index": { "type": "number", "minimum": 0.0 },
    "cuticle_hardness_index": { "type": "number", "minimum": 0.0 },
    "cephalic_horn_scale": { "type": "number", "minimum": 0.0 },
    "thoracic_horn_scale": { "type": "number", "minimum": 0.0 },
    "tarsal_grip_index": { "type": "number", "minimum": 0.0 },
    "metabolic_drain_index": { "type": "number", "minimum": 0.0 },
    "stamina_economy_modifier": { "type": "number", "minimum": 0.0 },
    "sensory_range_units": { "type": "number", "minimum": 0.0 },
    "cuticle_pigment_ratio": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "additionalProperties": false
}
