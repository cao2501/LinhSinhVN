{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrganismPhenotype",
  "description": "Computed morphological and physiological traits derived from gene expression",
  "type": "object",
  "required": [
    "schema_version",
    "sex",
    "body_length_mm",
    "body_mass_grams",
    "exoskeleton_hardness_gpa",
    "cephalic_horn_length_mm",
    "thoracic_horn_arch_mm",
    "tarsal_grip_newtons",
    "basal_metabolic_cost_cal_hr",
    "sensory_detection_radius_m",
    "cuticle_melanism_ratio"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "sex": { "type": "string", "enum": ["MALE", "FEMALE"] },
    "body_length_mm": { "type": "number", "minimum": 0.0 },
    "body_mass_grams": { "type": "number", "minimum": 0.0 },
    "exoskeleton_hardness_gpa": { "type": "number", "minimum": 0.0 },
    "cephalic_horn_length_mm": { "type": "number", "minimum": 0.0 },
    "thoracic_horn_arch_mm": { "type": "number", "minimum": 0.0 },
    "tarsal_grip_newtons": { "type": "number", "minimum": 0.0 },
    "basal_metabolic_cost_cal_hr": { "type": "number", "minimum": 0.0 },
    "sensory_detection_radius_m": { "type": "number", "minimum": 0.0 },
    "cuticle_melanism_ratio": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
  },
  "additionalProperties": false
}
