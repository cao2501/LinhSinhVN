{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://linhsinhvn.game/schemas/population/population_state.schema.json",
  "title": "PopulationState",
  "description": "Deterministic serializable snapshot of a population registry",
  "type": "object",
  "required": [
    "schema_version",
    "population_id",
    "species_id",
    "simulation_seed",
    "living_count",
    "dead_count",
    "total_count",
    "organisms"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "population_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique population identifier"
    },
    "species_id": {
      "type": "string",
      "minLength": 1,
      "description": "Species identifier for organisms in this population"
    },
    "simulation_seed": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{16}$",
      "description": "64-bit hexadecimal simulation master seed"
    },
    "living_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Derived count of currently living organisms"
    },
    "dead_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Derived count of deceased organisms retained in registry"
    },
    "total_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Total count of organism records (living + dead)"
    },
    "organisms": {
      "type": "array",
      "description": "Array of organism records strictly sorted by organism_id ascending",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
